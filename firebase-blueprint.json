{
  "entities": {
    "Evaluation": {
      "title": "Evaluation",
      "description": "Record of a student's educational activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mode": { "type": "string" },
        "grade": { "type": "string" },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "role": { "type": "string", "enum": ["apprenant", "administrateur"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "mode", "grade", "subject", "content", "timestamp", "role"]
    },
    "AccessCode": {
      "title": "Access Code",
      "description": "A unique access code for the application",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "isUsed": { "type": "boolean" },
        "usedByDeviceId": { "type": "string" }
      },
      "required": ["code", "createdAt", "expiresAt", "isUsed"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Application administrator",
      "type": "object",
      "properties": {
        "email": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/evaluations/{evaluationId}": {
      "schema": "Evaluation",
      "description": "Educational evaluations and student activities"
    },
    "/access_codes/{codeId}": {
      "schema": "AccessCode",
      "description": "Access codes for student registration"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Whitelisted administrator emails"
    }
  }
}
